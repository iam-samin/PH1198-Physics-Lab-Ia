import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import linregress

# 1. Dataset for the biggest ball
data_large = {
    'displacement_cm': [1, 2, 3, 4, 5, 6, 7, 8],
    'time1_s': [2.74, 5.46, 8.34, 11.12, 13.67, 16.20, 18.77, 21.58],
    'time2_s': [3.23, 6.20, 8.91, 11.38, 14.64, 16.69, 19.02, 21.44],
    'time3_s': [2.63, 4.91, 7.70, 10.07, 12.23, 14.73, 17.05, 19.07],
    'time4_s': [3.17, 5.52, 8.37, 11.46, 13.60, 16.41, 19.07, 21.53],
    'time5_s': [2.56, 5.21, 7.61, 9.91, 12.99, 15.28, 17.76, 20.95],
    'time6_s': [2.58, 5.17, 7.72, 10.21, 12.72, 15.29, 18.01, 20.43]
}
df = pd.DataFrame(data_large)

# 2. Calculate statistics
time_cols = [col for col in df.columns if 'time' in col]
df['mean_time_s'] = df[time_cols].mean(axis=1)
df['std_dev_s'] = df[time_cols].std(axis=1, ddof=1)
df['std_error_s'] = df['std_dev_s'] / np.sqrt(len(time_cols))

# 3. Perform Linear Regression
slope, intercept, r_value, p_value, std_err = linregress(df['mean_time_s'], df['displacement_cm'])
terminal_velocity = slope
terminal_velocity_uncertainty = std_err

# 4. Generate the plot
plt.style.use('seaborn-v0_8-whitegrid')
fig, ax = plt.subplots(figsize=(10, 7))

ax.errorbar(
    df['mean_time_s'],
    df['displacement_cm'],
    xerr=df['std_error_s'],
    yerr=0.1,
    fmt='o',
    color='blue',
    ecolor='gray',
    capsize=4,
    label='Biggest Ball Data'
)

x_fit = np.linspace(df['mean_time_s'].min() * 0.9, df['mean_time_s'].max() * 1.1, 100)
y_fit = terminal_velocity * x_fit + intercept

# CHANGED: linestyle='-' creates a solid line
ax.plot(x_fit, y_fit, color='dodgerblue', linestyle='-', label='Linear Fit')

ax.set_xlabel('Time $t$ / s', fontsize=14)
ax.set_ylabel('Displacement $y$ / cm', fontsize=14)
ax.set_title('Displacement vs. Time for Biggest Ball', fontsize=16)
ax.legend(fontsize=12, loc='lower right')

# Text box formatting
unc_rounded_str = f"{terminal_velocity_uncertainty:.2g}"
if '.' in unc_rounded_str:
    num_decimals_unc = len(unc_rounded_str.split('.')[1])
else:
    num_decimals_unc = 0
vel_rounded_str = f"{terminal_velocity:.{num_decimals_unc}f}"

fit_text = (
    f"Linear Fit: $y = v_T \\cdot t + y_0$\n\n"
    f"Terminal Velocity ($v_T$):\n"
    f"  ${vel_rounded_str} \\pm {unc_rounded_str}$ cm/s\n\n"
    f"R-squared: ${r_value**2:.4f}$"
)
props = dict(boxstyle='round', facecolor='white', alpha=0.8, edgecolor='gray')
ax.text(0.05, 0.95, fit_text, transform=ax.transAxes, fontsize=11,
        verticalalignment='top', bbox=props)

plt.tight_layout()
plt.show()
